<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Amperfy" parent="android:Theme.Material.NoActionBar">
        <!-- Edge-to-Edge 配置 - iOS 风格沉浸式体验 (深色模式) -->
        <!-- 状态栏透明,让内容延伸到状态栏下方 -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- 导航栏透明,让内容延伸到导航栏下方 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- 强制启用 Edge-to-Edge 绘制 (Android 15+) -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <!-- 启动屏（深色）：底色与 Logo 着色均由 values-night/colors.xml 提供，
         对齐 iOS systemBackgroundColor 深色态与 Icon-monocolor 的 dark 变体（白字形）；
         "Amperfy" 大标题与底部版权行同样由 Compose 复刻层
         （ui/screens/LaunchScreenOverlay.kt，颜色随 colorScheme 自动取深色态）接力补上 -->
    <style name="Theme.Amperfy.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Amperfy</item>
    </style>
</resources>
